# 复制为本 skill 根目录的 .env；不要提交本机 .env。
# 值可带引号；注释独占一行。相对路径以 .env 所在目录为基准。
# 支持 ${VARIABLE} 引用；文件值优先，未在文件定义的引用可读取进程环境变量。

# 必填：本次处理的实际 addon；也可通过校验脚本 -AddonRoot 指定。
GMOD_ADDON_DIR=C:\Path\To\YourAddon

# 可选：仅改 Lua / 离线读 MDL 时，无需安装 GMod 或模型编译工具。
# GMOD_ROOT=C:\Path\To\SteamLibrary\steamapps\common\GarrysMod
# GMOD_TOOLS_DIR=D:\GModTools

# 可选：显式工具路径覆盖按 GMOD_ROOT / GMOD_TOOLS_DIR 推导的默认值。
# CROWBAR_EXE=${GMOD_TOOLS_DIR}\Crowbar\Crowbar.exe
# CROWBAR_CLI_EXE=${GMOD_TOOLS_DIR}\CrowbarCLI.exe
# STUDIOMDL_EXE=${GMOD_ROOT}\bin\studiomdl.exe
# STUDIOMDL_CE_X64_EXE=${GMOD_TOOLS_DIR}\StudioMDL-CE\x64\cestudiomdl.exe
GMOD_PYTHON_EXE=python

# 需要 Blender 编辑/复核时指定，并自行确认 Blender Source Tools 可用。
# BLENDER_EXE=C:\Path\To\Blender\blender.exe
